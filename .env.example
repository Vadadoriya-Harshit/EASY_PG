# ---- Public site config ----
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Public contact details (leave blank to hide call / WhatsApp buttons until confirmed)
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_HERO_VIDEO=
NEXT_PUBLIC_HERO_POSTER=

# ---- Database ----
# Without MONGODB_URI the app runs on an in-memory demo store (data resets on restart).
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/luxora_pg?retryWrites=true&w=majority

# ---- Admin auth (REQUIRED in production) ----
# AUTH_SECRET signs sessions and e-mail links. 32+ random characters, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# There is NO built-in fallback secret and NO built-in default password.
AUTH_SECRET=your_32_character_random_auth_secret_here
# Used once to create the first super admin when the admin_users collection is empty. Use a strong password (10+ chars, letters and numbers).
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=change_this_to_a_strong_password
# Set to "false" to sign in directly with password without requiring OTP email:
# REQUIRE_ADMIN_OTP=false

# ---- Dynamic Rate Limiting & Throttling Config ----
# Set to "true" to completely disable all rate limits (ideal for testing/staging):
# DISABLE_RATE_LIMIT=false
# Maximum auth attempts (login, verify-otp, resend-otp, reset-password) before throttle:
# AUTH_RATE_LIMIT_MAX=10
# Window in seconds for auth rate limiting (default: 300s / 5 minutes):
# AUTH_RATE_LIMIT_WINDOW_SEC=300
# Resend OTP cooldown timer in seconds (default: 60s):
# OTP_RESEND_COOLDOWN_SEC=60
# Max OTP dispatch sends per hour per account (default: 5):
# OTP_MAX_SENDS_PER_HOUR=10
# Max OTP wrong guesses before locking code (default: 5):
# OTP_MAX_ATTEMPTS=5
# Account lockout after repeated bad passwords (default: 8 fails, 15 min lock):
# ACCOUNT_LOCK_MAX_FAILS=8
# ACCOUNT_LOCK_DURATION_MIN=15

# ---- Transactional e-mail (admin OTP + vacancy alerts) ----
# OPTION A (Recommended for Vercel Serverless - never times out, uses HTTPS port 443):
# Sign up free at resend.com (3000 emails/mo) and paste your API key here:
# RESEND_API_KEY=re_your_api_key_here

# OPTION B: SMTP (Works on VPS / Localhost, but cloud serverless firewalls may block raw SMTP):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Luxora PG <no-reply@your-domain.example>"
# Development only: EMAIL_DRIVER=file writes messages to ./.mail-outbox instead of sending. Ignored in production.
# EMAIL_DRIVER=file

# ---- Vacancy-alert queue ----
# Bearer token for /api/cron/vacancy-notifications (retries failed deliveries). 16+ random characters.
CRON_SECRET=your_random_cron_secret_here

# ---- Cloudinary (optional, for admin media uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Misc ----
# Production redirects http -> https when a proxy reports x-forwarded-proto=http. Set to "false" only if TLS is terminated elsewhere and the header is not forwarded.
# FORCE_HTTPS=true
