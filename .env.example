# ---- Public site config ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public contact details (leave blank to hide call / WhatsApp buttons until confirmed)
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=            # digits only with country code, e.g. 91XXXXXXXXXX
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS=
# Optional hero video (mp4/webm URL, short compressed loop) and poster
NEXT_PUBLIC_HERO_VIDEO=
NEXT_PUBLIC_HERO_POSTER=

# ---- Database (optional locally: without it the app uses an in-memory sample store) ----
MONGODB_URI=

# ---- Admin auth ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---- Cloudinary (optional, for admin media uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
